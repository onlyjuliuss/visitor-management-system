# SMS Configuration
# For testing without real SMS, set SMS_MOCK_MODE=true
SMS_MOCK_MODE=true

# For production SMS (Twilio), set these environment variables:
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# Phone input supports: 0551234567, 233551234567, +233551234567

# Database Configuration
# DATABASE_URL=postgres://user:password@localhost:5432/visitor_db?sslmode=disable
#
# Supabase transaction pooler: set DB_SIMPLE_PROTOCOL=true if you see pq 26000 / 08P01
# (prepared statement / bind format errors). Prefer session pooler or direct host when possible.
# DB_SIMPLE_PROTOCOL=true